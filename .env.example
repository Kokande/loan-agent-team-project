# Учебные локальные реквизиты. Для другого окружения замените их.
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag_local_only
POSTGRES_DB=loan_agent
RAG_POSTGRES_PORT=5432
RAG_OLLAMA_PORT=11434

# Для запуска Python вне Docker; пароль в URL должен быть URL-encoded.
RAG_DATABASE_URL=postgresql://rag:rag_local_only@localhost:5432/loan_agent
RAG_EMBEDDING_PROVIDER=ollama
RAG_OLLAMA_URL=http://localhost:11434
RAG_EMBEDDING_MODEL=bge-m3
RAG_EMBEDDING_DIMENSIONS=1024
RAG_EMBEDDING_TIMEOUT=120
RAG_EMBEDDING_BATCH_SIZE=16
RAG_CHUNK_SIZE=1600
RAG_CHUNK_OVERLAP=200

# Облачный режим: смените PROVIDER на api и MODEL на модель поставщика,
# например text-embedding-v4 для Alibaba. BASE_URL указывается без /embeddings.
# Инструкция и пример регионального адреса: docs/RAG.md.
RAG_EMBEDDING_API_BASE_URL=
RAG_EMBEDDING_API_KEY=
